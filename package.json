{
  "name": "tastellar-workspace",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/tastellar"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @tastellar/app",
    "build": "npm run build --workspace @tastellar/app",
    "test": "npm run test --workspace @tastellar/app",
    "desktop": "node scripts/desktop.mjs dev",
    "desktop:build": "node scripts/desktop.mjs build",
    "desktop:build:macos": "node scripts/desktop.mjs build macos app",
    "desktop:build:app": "node scripts/desktop.mjs build macos app",
    "desktop:build:dmg": "node scripts/desktop.mjs build macos dmg",
    "desktop:build:windows": "node scripts/desktop.mjs build windows",
    "test:e2e": "PLAYWRIGHT_BROWSERS_PATH=\"$PWD/.tools/browsers\" playwright test"
  },
  "devDependencies": {
    "prettier": "^3.9.9"
  }
}
